{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@nfl/types": ["packages/types/src/index.ts"],
      "@nfl/api-client": ["packages/api-client/src/index.ts"],
      "@nfl/ui": ["packages/ui/src/index.ts"]
    }
  }
}
